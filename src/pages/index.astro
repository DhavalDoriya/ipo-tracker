---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilterBar from '../components/FilterBar.astro';
import IpoList from '../components/IpoList.astro';
import { loadComingSoon, loadIpos, loadIposFile } from '../lib/data';
import { formatUpdated } from '../lib/format';
import { url } from '../lib/url';

const PIPELINE_LIMIT = 8;

const ipos = loadIpos();
const { updated_at } = loadIposFile();
const open = ipos.filter((i) => i.status === 'open');
const upcoming = ipos.filter((i) => i.status === 'upcoming');
const recent = ipos.filter((i) => i.status === 'closed' || i.status === 'listed');
const comingSoon = loadComingSoon();
const pipeline = comingSoon.ipos;
// Pipeline rows filter as "upcoming", so the chip count includes them.
const counts = {
  open: open.length,
  upcoming: upcoming.length + pipeline.length,
  closed: ipos.filter((i) => i.status === 'closed').length,
  listed: ipos.filter((i) => i.status === 'listed').length,
};
---

<BaseLayout
  title="Today's IPOs"
  description="Open, upcoming and recently listed mainboard and SME IPOs in India, with dates, issue price and subscription."
>
  <div data-filter-scope>
    <section class="hero">
      <h1>Today's IPOs</h1>
      <p class="muted">
        Mainboard and SME issues in India, with {pipeline.length} more in the pipeline. Updated{' '}
        <time datetime={updated_at}>{formatUpdated(updated_at)}</time>.
      </p>
      <FilterBar counts={counts} />
    </section>

    <section class="section" aria-labelledby="open">
      <h2 id="open">Open now</h2>
      <IpoList ipos={open} emptyText="No IPOs are open for bidding today." />
    </section>

    <section class="section" aria-labelledby="soon">
      <h2 id="soon">Coming soon</h2>
      <IpoList ipos={upcoming} emptyText="No IPO has announced its dates yet." />
      {
        pipeline.length > 0 && (
          <div class="pipeline" data-filter-group data-limit={PIPELINE_LIMIT}>
            <h3>In the pipeline</h3>
            <p class="muted note">
              Offer documents are filed but dates are not announced. A filing does not mean the IPO
              will happen.
              {comingSoon.source && ` Source: ${comingSoon.source}.`}
            </p>
            <ul class="rows">
              {pipeline.map((p, i) => (
                <li
                  data-ipo-card
                  data-name={p.name.toLowerCase()}
                  data-status="upcoming"
                  hidden={i >= PIPELINE_LIMIT}
                >
                  {p.source_url ? (
                    <a href={p.source_url} rel="noopener noreferrer">
                      {p.name}
                    </a>
                  ) : (
                    <span class="name">{p.name}</span>
                  )}
                  <span class="muted">
                    {[p.type === 'sme' ? 'SME' : 'Mainboard', p.exchange, p.expected ?? 'Dates awaited']
                      .filter(Boolean)
                      .join(', ')}
                  </span>
                </li>
              ))}
            </ul>
            <p class="muted" data-group-empty hidden>
              No filings match your search.
            </p>
            {pipeline.length > PIPELINE_LIMIT && (
              <div class="actions">
                <button class="btn btn-tonal" type="button" data-more>
                  Show all {pipeline.length}
                </button>
              </div>
            )}
          </div>
        )
      }
    </section>

    <section class="section" aria-labelledby="recent">
      <h2 id="recent">Recently closed and listed</h2>
      <IpoList ipos={recent} limit={6} emptyText="Nothing has closed or listed in the last 30 days." />
    </section>
  </div>

  <section class="section next" aria-labelledby="next">
    <h2 id="next">Before you apply</h2>
    <p class="muted">Check the issue yourself, then follow the steps to bid.</p>
    <div class="actions">
      <a class="btn" href={url('/checklist/')}>Open the analysis checklist</a>
      <a class="btn btn-tonal" href={url('/guides/how-to-apply/')}>How to apply</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    margin-top: var(--space-2);
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius-md);
    background: var(--color-surface-tint);
  }

  .hero p {
    margin: var(--space-2) 0 var(--space-5);
    max-width: 70ch;
  }

  .pipeline {
    margin-top: var(--space-6);
  }

  .note {
    margin: var(--space-1) 0 var(--space-3);
    max-width: 80ch;
  }

  .name {
    font-weight: 500;
  }

  .next {
    margin-top: var(--space-6);
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .next h2 {
    margin-bottom: var(--space-1);
  }

  @media (min-width: 569px) {
    .hero,
    .next {
      padding: 40px;
    }
  }
</style>
