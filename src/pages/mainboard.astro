---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilterBar from '../components/FilterBar.astro';
import IpoList from '../components/IpoList.astro';
import { loadIpos } from '../lib/data';

const ipos = loadIpos().filter((i) => i.type === 'mainboard');
---

<BaseLayout
  title="Mainboard IPOs"
  description="Mainboard IPOs on NSE and BSE: dates, price band, lot size, issue size and subscription."
>
  <div class="page-head">
    <h1>Mainboard IPOs</h1>
    <p>Issues listing on the main boards of NSE and BSE.</p>
  </div>
  <div data-filter-scope>
    <div class="filter">
      <FilterBar />
    </div>
    <IpoList ipos={ipos} emptyText="No mainboard IPOs to show right now." />
  </div>
</BaseLayout>

<style>
  .filter {
    margin-bottom: var(--space-5);
  }
</style>
