---
import BaseLayout from '../layouts/BaseLayout.astro';
import BuybackCard from '../components/BuybackCard.astro';
import Notice from '../components/Notice.astro';
import { loadBuybacks } from '../lib/data';
import { formatUpdated } from '../lib/format';

const { buybacks, updated_at, sample } = loadBuybacks();
const order = { open: 0, upcoming: 1, closed: 2 };
const sorted = [...buybacks].sort((a, b) => order[a.status] - order[b.status]);
---

<BaseLayout
  title="Buyback calendar"
  description="Share buybacks in India: record date, tender window and buyback price."
>
  <div class="page-head">
    <h1>Buyback calendar</h1>
    <p>
      Record dates, tender windows and prices. Updated
      <time datetime={updated_at}>{formatUpdated(updated_at)}</time>.
    </p>
  </div>
  {
    sample && (
      <div class="sample">
        <Notice>
          <strong>Sample data.</strong> These buybacks are placeholders, not real offers.
        </Notice>
      </div>
    )
  }
  {
    sorted.length === 0 ? (
      <p class="muted">No buybacks announced right now.</p>
    ) : (
      <ul class="grid">
        {sorted.map((b) => (
          <BuybackCard buyback={b} />
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .sample {
    margin-bottom: var(--space-4);
  }
</style>
