---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilterBar from '../components/FilterBar.astro';
import IpoList from '../components/IpoList.astro';
import { loadIpos } from '../lib/data';

const ipos = loadIpos().filter((i) => i.type === 'sme');
const counts = {
  open: ipos.filter((i) => i.status === 'open').length,
  upcoming: ipos.filter((i) => i.status === 'upcoming').length,
  closed: ipos.filter((i) => i.status === 'closed').length,
  listed: ipos.filter((i) => i.status === 'listed').length,
};
---

<BaseLayout
  title="SME IPOs"
  description="SME IPOs on NSE Emerge and BSE SME: dates, price band, lot size, issue size and subscription."
>
  <div class="page-head">
    <h1>SME IPOs</h1>
    <p>
      Issues on NSE Emerge and BSE SME. Lot sizes are large and liquidity after listing can be thin.
    </p>
  </div>
  <div data-filter-scope>
    <div class="filter">
      <FilterBar counts={counts} />
    </div>
    <IpoList ipos={ipos} emptyText="No SME IPOs to show right now." />
  </div>
</BaseLayout>

<style>
  .filter {
    margin-bottom: var(--space-5);
  }
</style>
