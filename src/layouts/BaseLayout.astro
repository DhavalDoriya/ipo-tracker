---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Notice from '../components/Notice.astro';
import { loadIposFile } from '../lib/data';
import { url } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const { sample } = loadIposFile();
---

<!doctype html>
<html lang="en-IN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | IPO Update</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <Font cssVariable="--font-roboto" preload />
    <script is:inline>
      // Set the theme before first paint: saved choice, else the system setting.
      (function () {
        var theme;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <noscript>
      <style>
        [data-ipo-card][hidden] {
          display: block !important;
        }
        [data-more],
        [data-filter-form] {
          display: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="container">
      {
        sample && (
          <Notice>
            <strong>Sample data.</strong> The companies and numbers shown are placeholders, not real issues.
          </Notice>
        )
      }
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    padding: var(--space-2) var(--space-4);
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: var(--radius-pill);
    z-index: 10;
  }

  .skip:focus {
    top: var(--space-2);
  }

  main {
    padding-top: var(--space-4);
    padding-bottom: var(--space-section);
    min-height: 60vh;
  }
</style>
