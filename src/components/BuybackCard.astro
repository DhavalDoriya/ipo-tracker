---
import Avatar from './Avatar.astro';
import StatusChip from './StatusChip.astro';
import type { Buyback } from '../lib/data';
import { formatDate, formatDateRange, formatInr } from '../lib/format';

interface Props {
  buyback: Buyback;
}

const { buyback } = Astro.props;
---

<li class="card">
  <article>
    <header>
      <Avatar name={buyback.name} />
      <div class="title">
        <h3>{buyback.name}</h3>
        <p class="muted meta">{buyback.type === 'tender' ? 'Tender offer' : 'Open market'}</p>
      </div>
      <StatusChip status={buyback.status} />
    </header>
    <dl>
      <div class="price"><dt>Buyback price</dt><dd>{formatInr(buyback.buyback_price)}</dd></div>
      <div><dt>Record date</dt><dd>{formatDate(buyback.record_date)}</dd></div>
      <div><dt>Open to close</dt><dd>{formatDateRange(buyback.open_date, buyback.close_date)}</dd></div>
    </dl>
  </article>
</li>

<style>
  header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .title {
    flex: 1;
    min-width: 0;
  }

  h3 {
    overflow-wrap: anywhere;
  }

  .meta {
    font: var(--text-small);
  }

  dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-4);
  }

  dt {
    font: var(--text-small);
    color: var(--color-text-muted);
  }

  dd {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .price dd {
    font: var(--text-figure);
  }
</style>
