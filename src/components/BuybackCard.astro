---
import StatusChip from './StatusChip.astro';
import type { Buyback } from '../lib/data';
import { formatDate, formatDateRange, formatInr } from '../lib/format';

interface Props {
  buyback: Buyback;
}

const { buyback } = Astro.props;
---

<li class="card">
  <article>
    <header>
      <div>
        <h3>{buyback.name}</h3>
        <p class="muted meta">{buyback.type === 'tender' ? 'Tender offer' : 'Open market'}</p>
      </div>
      <StatusChip status={buyback.status} />
    </header>
    <dl>
      <div><dt>Buyback price</dt><dd>{formatInr(buyback.buyback_price)}</dd></div>
      <div><dt>Record date</dt><dd>{formatDate(buyback.record_date)}</dd></div>
      <div class="wide"><dt>Open – close</dt><dd>{formatDateRange(buyback.open_date, buyback.close_date)}</dd></div>
    </dl>
  </article>
</li>

<style>
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    transition: box-shadow var(--dur-base) var(--ease);
  }

  .card:hover {
    box-shadow: var(--shadow-card);
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .meta {
    font: var(--text-small);
  }

  dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-4);
  }

  .wide {
    grid-column: 1 / -1;
  }

  dt {
    font: var(--text-small);
    color: var(--color-text-muted);
  }

  dd {
    font-weight: 500;
  }
</style>
