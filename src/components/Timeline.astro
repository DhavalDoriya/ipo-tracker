---
// Steps of a real sequence (an issue's dates, a filing's stages). A dot fills once its step
// has happened; the line to the next dot fills once that one has happened too.
interface Props {
  label: string;
  steps: { label: string; value: string; done: boolean }[];
}

const { label, steps } = Astro.props;
---

<ol class="timeline" aria-label={label} style={`--steps: ${steps.length}`} data-timeline>
  {
    steps.map((step, i) => (
      <li class:list={{ done: step.done, through: step.done && steps[i + 1]?.done }} style={`--n: ${i}`}>
        <span class="label">{step.label}</span>
        <span class="value">{step.value}</span>
      </li>
    ))
  }
</ol>

<script>
  // Mark a timeline once it is on screen so its progress line draws in (see the CSS).
  const timelines = document.querySelectorAll('[data-timeline]');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.setAttribute('data-seen', '');
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.6 },
    );
    timelines.forEach((t) => observer.observe(t));
  } else {
    timelines.forEach((t) => t.setAttribute('data-seen', ''));
  }
</script>

<style>
  .timeline {
    display: grid;
    grid-template-columns: repeat(var(--steps), 1fr);
    margin-top: var(--space-5);
    padding: var(--space-4) 0 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  li {
    position: relative;
    padding-top: var(--space-4);
  }

  li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pill);
    border: 2px solid var(--color-text-muted);
    background: var(--color-bg);
    box-sizing: border-box;
  }

  li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 4px;
    left: 14px;
    right: 4px;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--color-border);
  }

  li.done::before {
    border-color: var(--color-primary);
    background: var(--color-primary);
  }

  li.through::after {
    background: var(--color-primary);
    transform-origin: left;
    transition: transform var(--dur-slow) var(--ease);
    transition-delay: calc(var(--n) * 180ms);
  }

  /* Until the timeline is seen the line is undrawn. Only with JS, so it can never stay empty. */
  :global(.js) .timeline:not([data-seen]) li.through::after {
    transform: scaleX(0);
  }

  .label {
    display: block;
    font: var(--text-small);
    color: var(--color-text-muted);
  }

  .value {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
</style>
