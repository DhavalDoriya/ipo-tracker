---
import ThemeToggle from './ThemeToggle.astro';
import { url } from '../lib/url';

const links = [
  { href: '/', label: 'Home' },
  { href: '/mainboard/', label: 'Mainboard' },
  { href: '/sme/', label: 'SME' },
  { href: '/buybacks/', label: 'Buybacks' },
  { href: '/checklist/', label: 'Checklist' },
  { href: '/guides/', label: 'Guides' },
  { href: '/about/', label: 'About' },
];

const current = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) =>
  href === '/' ? current === url('/') : current.startsWith(url(href));
---

<header class="header">
  <div class="container bar">
    <a class="brand" href={url('/')}>
      <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="var(--color-primary)"></rect>
        <path
          d="M7 22l6-7 4 4 8-10"
          fill="none"
          stroke="var(--color-on-primary)"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      IPO Update
    </a>
    <div class="toggle"><ThemeToggle /></div>
    <nav aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={url(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    padding-block: var(--space-1);
  }

  nav {
    grid-column: 1 / -1;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    justify-self: start;
    min-height: var(--touch);
    font: 500 1.25rem/1.25 var(--font-sans);
    color: var(--color-text);
    text-decoration: none;
  }

  nav {
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(var(--space-4) * -1);
    padding-inline: var(--space-4);
  }

  ul {
    display: flex;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    padding-inline: var(--space-4);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color var(--dur-base) var(--ease);
  }

  nav a:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }

  nav a[aria-current='page'] {
    background: var(--color-primary-container);
    color: var(--color-on-primary-container);
  }

  nav a:focus-visible {
    outline-offset: -2px;
  }

  @media (min-width: 900px) {
    .header {
      position: sticky;
      top: 0;
      z-index: 5;
    }

    .bar {
      grid-template-columns: auto 1fr auto;
      gap: var(--space-4);
      padding-block: var(--space-2);
    }

    nav {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
      margin-inline: 0;
      padding-inline: 0;
    }

    .toggle {
      grid-column: 3;
    }
  }
</style>
