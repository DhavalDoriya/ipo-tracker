---
import ThemeToggle from './ThemeToggle.astro';
import { url } from '../lib/url';

const links = [
  { href: '/', label: 'Home' },
  { href: '/mainboard/', label: 'Mainboard' },
  { href: '/sme/', label: 'SME' },
  { href: '/buybacks/', label: 'Buybacks' },
  { href: '/checklist/', label: 'Checklist' },
  { href: '/guides/', label: 'Guides' },
  { href: '/about/', label: 'About' },
];

const current = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) =>
  href === '/' ? current === url('/') : current.startsWith(url(href));
---

<header class="header">
  <div class="container bar">
    <a class="brand" href={url('/')}>
      <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="var(--color-primary)"></rect>
        <path
          d="M7 22l6-7 4 4 8-10"
          fill="none"
          stroke="var(--color-on-primary)"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      IPO Update
    </a>

    <!-- Wide screens: links sit in the bar. -->
    <nav class="inline" aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={url(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />

    <!-- Small screens: the same links in a menu. <details> keeps it working without JavaScript. -->
    <details class="menu" data-menu>
      <summary aria-label="Menu">
        <svg class="open" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <path fill="currentColor" d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z"></path>
        </svg>
        <svg class="close" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
          ></path>
        </svg>
      </summary>
      <nav class="sheet" aria-label="Menu">
        <ul class="container">
          {
            links.map((l) => (
              <li>
                <a href={url(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  // Close the menu on Escape or a tap outside it.
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
  if (menu) {
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 5;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 56px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-right: auto;
    min-height: var(--touch);
    font: 500 1.25rem/1.25 var(--font-sans);
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  ul {
    padding: 0;
    list-style: none;
  }

  nav a {
    display: flex;
    align-items: center;
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 500;
    transition: background-color var(--dur-base) var(--ease);
  }

  nav a:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }

  nav a[aria-current='page'] {
    background: var(--color-primary-container);
    color: var(--color-on-primary-container);
  }

  /* Bar links: hidden until there is room for all of them. */
  .inline {
    display: none;
  }

  .inline ul {
    display: flex;
    gap: var(--space-1);
  }

  .inline a {
    min-height: var(--touch);
    padding-inline: var(--space-4);
    white-space: nowrap;
  }

  summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--touch);
    height: var(--touch);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    transition: background-color var(--dur-base) var(--ease);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    background: var(--color-surface);
  }

  .close,
  .menu[open] .open {
    display: none;
  }

  .menu[open] .close {
    display: block;
  }

  .menu[open] summary {
    background: var(--color-surface);
  }

  /* The menu drops from the bar across the full width. */
  .sheet {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding-block: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    background: var(--color-bg);
    box-shadow: var(--shadow-card);
  }

  .sheet ul {
    padding-inline: var(--space-3);
  }

  .sheet li + li {
    margin-top: var(--space-1);
  }

  .sheet a {
    min-height: 48px;
    padding-inline: var(--space-5);
    font: 500 1rem/1.5 var(--font-sans);
  }

  @media (min-width: 900px) {
    .bar {
      gap: var(--space-2);
      min-height: 64px;
    }

    .inline {
      display: block;
    }

    .menu {
      display: none;
    }
  }
</style>
