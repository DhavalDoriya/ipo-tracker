---
import Avatar from './Avatar.astro';
import StatusChip from './StatusChip.astro';
import type { IpoWithGmp } from '../lib/data';
import { formatDayMonth, formatInr, formatNumber, formatPriceBand, listingGain } from '../lib/format';
import { url } from '../lib/url';

interface Props {
  ipo: IpoWithGmp;
  checklistSlug?: string;
  hidden?: boolean;
}

const { ipo, checklistSlug, hidden = false } = Astro.props;
const breakup = ipo.subscription_breakup;
const price = ipo.offer_price;
const gain = listingGain(price?.max, ipo.list_price);

// How far the issue has got: 0 = announced, 1 = opened, 2 = closed, 3 = listed.
const reached = { upcoming: 0, open: 1, closed: 2, listed: 3 }[ipo.status];
const steps = [
  { label: 'Opens', date: ipo.open_date },
  { label: 'Closes', date: ipo.close_date },
  { label: 'Lists', date: ipo.listing_date },
];
const sourceHost = ipo.source_url ? new URL(ipo.source_url).hostname.replace(/^www\./, '') : null;
---

<li class="card" data-ipo-card data-name={ipo.name.toLowerCase()} data-status={ipo.status} hidden={hidden}>
  <article>
    <header>
      <Avatar name={ipo.name} />
      <div class="title">
        <h3>{ipo.name}</h3>
        <p class="muted meta">
          {ipo.type === 'sme' ? 'SME' : 'Mainboard'}{ipo.exchange && `, ${ipo.exchange}`}
        </p>
      </div>
      <StatusChip status={ipo.status} />
    </header>

    <dl class="figures">
      <div>
        <dt>{price && price.min !== price.max ? 'Price band' : 'Issue price'}</dt>
        <dd>{formatPriceBand(price)}</dd>
      </div>
      {
        ipo.subscription && (
          <div>
            <dt>Subscribed</dt>
            <dd>{ipo.subscription}</dd>
          </div>
        )
      }
      {
        ipo.list_price != null && (
          <div>
            <dt>Listed at</dt>
            <dd>
              {formatInr(ipo.list_price)}
              {gain && (
                <span class:list={['gain', { up: gain.pct > 0, down: gain.pct < 0 }]}>{gain.text}</span>
              )}
            </dd>
          </div>
        )
      }
      {
        ipo.lot_size != null && (
          <div>
            <dt>Lot size</dt>
            <dd>{formatNumber(ipo.lot_size)} shares</dd>
          </div>
        )
      }
      {
        ipo.issue_size && (
          <div>
            <dt>Issue size</dt>
            <dd>{ipo.issue_size}</dd>
          </div>
        )
      }
      {
        ipo.gmp != null && (
          <div>
            <dt>GMP (unofficial)</dt>
            <dd>
              {formatInr(ipo.gmp)}
              {ipo.gmp_percent && <span class="gain">{ipo.gmp_percent}</span>}
            </dd>
          </div>
        )
      }
    </dl>

    {
      breakup && (
        <p class="muted breakup">
          Retail {breakup.retail ?? '—'}, HNI {breakup.hni ?? '—'}, QIB {breakup.qib ?? '—'}
        </p>
      )
    }

    <ol class="timeline" aria-label="Issue dates">
      {
        steps.map((step, i) => (
          <li class:list={{ done: reached > i, through: reached > i + 1 }}>
            <span class="label">{step.label}</span>
            <span class="date">{formatDayMonth(step.date)}</span>
          </li>
        ))
      }
    </ol>

    {
      (checklistSlug || ipo.source_url) && (
        <p class="links">
          {checklistSlug && <a href={url(`/checklist/${checklistSlug}/`)}>Analysis checklist</a>}
          {ipo.source_url && (
            <a href={ipo.source_url} rel="noopener noreferrer">
              View on {sourceHost}
            </a>
          )}
        </p>
      )
    }
  </article>
</li>

<style>
  header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .title {
    flex: 1;
    min-width: 0;
  }

  h3 {
    overflow-wrap: anywhere;
  }

  .meta {
    font: var(--text-small);
  }

  .figures {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-4);
  }

  dt {
    font: var(--text-small);
    color: var(--color-text-muted);
  }

  dd {
    font: var(--text-figure);
    font-variant-numeric: tabular-nums;
  }

  .gain {
    margin-left: var(--space-2);
    padding: 2px var(--space-2);
    border-radius: var(--radius-pill);
    font: var(--text-small);
    font-weight: 500;
    background: var(--color-surface);
    color: var(--color-text-muted);
    vertical-align: middle;
  }

  .gain.up {
    background: var(--color-success-bg);
    color: var(--color-success);
  }

  .gain.down {
    background: var(--color-danger-bg);
    color: var(--color-danger);
  }

  .breakup {
    margin-top: var(--space-2);
    font: var(--text-small);
  }

  /* Open -> close -> listing. A dot fills once that step has happened. */
  .timeline {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: var(--space-5);
    padding: var(--space-4) 0 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .timeline li {
    position: relative;
    padding-top: var(--space-4);
  }

  .timeline li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pill);
    border: 2px solid var(--color-text-muted);
    background: var(--color-bg);
    box-sizing: border-box;
  }

  .timeline li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 4px;
    left: 14px;
    right: 4px;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--color-border);
  }

  .timeline li.done::before {
    border-color: var(--color-primary);
    background: var(--color-primary);
  }

  .timeline li.through::after {
    background: var(--color-primary);
  }

  .label {
    display: block;
    font: var(--text-small);
    color: var(--color-text-muted);
  }

  .date {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin-top: var(--space-2);
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    font-weight: 500;
  }
</style>
